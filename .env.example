# Copy to .env and adjust. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_SETTINGS_MODULE=config.settings.local

# --- Database ---
POSTGRES_DB=bosskafe
POSTGRES_USER=bosskafe
POSTGRES_PASSWORD=bosskafe
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Cache ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO in dev, Cloudflare R2 in production) ---
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_URL=http://localhost:9100
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bosskafe-media

# --- Cross-service ---
# Django uses this to reach Next for on-demand ISR revalidation.
FRONTEND_URL=http://web:3000
REVALIDATE_SECRET=change-me-too

# --- Next.js ---
# Server-side only: the browser must never see the API host directly.
API_INTERNAL_URL=http://api:8000/api/v1
# Public origin used when generating QR code URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_DEFAULT_LOCALE=uz

# --- Legacy data migration (import_firestore management command) ---
FIRESTORE_PROJECT_ID=orginal-boss-kafe
FIRESTORE_COLLECTION=menu_items
