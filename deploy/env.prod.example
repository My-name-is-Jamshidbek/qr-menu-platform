# Production environment. Copy to the repository root as `.env.prod` and fill in
# every value; nothing here has a safe default.
#
#   cp deploy/env.prod.example .env.prod && chmod 600 .env.prod
#
# `.env.prod` must never be committed. Docker Compose reads it twice, for two
# different purposes:
#   * as the project env file (`--env-file .env.prod`) it interpolates the
#     ${...} placeholders in docker-compose.prod.yml — DOMAIN, SITE_IMAGE, tags
#   * as `env_file:` on the api and web services it becomes their process
#     environment — the Django and Next.js settings below
#
# Rotation procedure: deploy/deploy.md, "Rotating secrets".

# --- Edge --------------------------------------------------------------------
# The hostname the certificate is issued for. Must already resolve to this host.
DOMAIN=menu.example.uz
# Let's Encrypt sends expiry warnings here.
ACME_EMAIL=ops@example.uz
# Public origin, scheme included. Used by Next.js for canonical URLs and by
# Django for the CORS allowlist.
SITE_URL=https://menu.example.uz

# --- Images ------------------------------------------------------------------
# Tag every deploy with the git SHA so a rollback is `IMAGE_TAG=<old sha> up -d`.
IMAGE_TAG=latest
API_IMAGE=bosskafe/api
WEB_IMAGE=bosskafe/web
# `next build` prerenders the menu and therefore calls the API during the image
# build, when the compose network does not exist yet. Point this at an API the
# builder can reach; see deploy.md, "First deploy".
BUILD_API_INTERNAL_URL=http://127.0.0.1:8000/api/v1

# --- Django ------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
# 50+ random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=False
# Comma-separated. Include the bare hostname, not the scheme.
DJANGO_ALLOWED_HOSTS=menu.example.uz
LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
POSTGRES_DB=bosskafe
POSTGRES_USER=bosskafe
# Generate with: openssl rand -base64 36
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --- Cache -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=256mb

# --- Object storage (Cloudflare R2) ------------------------------------------
# R2 is S3-compatible, so the same django-storages backend is used unchanged.
S3_BUCKET=bosskafe-media
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# The public base URL of the bucket — this one ends up in <img src>.
S3_PUBLIC_URL=https://media.example.uz
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_REGION=auto

# --- Frontend ----------------------------------------------------------------
# Where Django POSTs its cache-invalidation webhook. Internal name, not the
# public URL: it never has to leave the host.
FRONTEND_URL=https://menu.example.uz
# Shared secret for POST /api/revalidate. Generate with: openssl rand -hex 32
REVALIDATE_SECRET=CHANGE_ME
API_INTERNAL_URL=http://api:8000/api/v1
NEXT_PUBLIC_SITE_URL=https://menu.example.uz
NEXT_PUBLIC_DEFAULT_LOCALE=uz
DEFAULT_LOCALE=uz

# --- Gunicorn ----------------------------------------------------------------
# Rule of thumb: (2 x CPU cores) + 1.
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# --- Backups -----------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# --- Legacy import (only needed when running `make import`) -------------------
FIRESTORE_PROJECT_ID=orginal-boss-kafe
FIRESTORE_COLLECTION=menu_items
