# Same values as .env, but with host-reachable addresses.
# Use when running manage.py / npm directly on the host instead of inside compose:
#   set -a; source .env.hostdev; set +a

DJANGO_SECRET_KEY=dev-only-not-a-real-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.local

POSTGRES_DB=bosskafe
POSTGRES_USER=bosskafe
POSTGRES_PASSWORD=bosskafe
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

REDIS_URL=redis://localhost:6382/0

S3_ENDPOINT_URL=http://localhost:9100
S3_PUBLIC_URL=http://localhost:9100
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bosskafe-media

FRONTEND_URL=http://localhost:3100
REVALIDATE_SECRET=dev-revalidate-secret

API_INTERNAL_URL=http://localhost:8100/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_DEFAULT_LOCALE=uz

FIRESTORE_PROJECT_ID=orginal-boss-kafe
FIRESTORE_COLLECTION=menu_items
